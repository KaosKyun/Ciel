{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "plugin": [
    "./.opencode/plugins/ciel.js",
    "@neikyun/ciel"
  ],
  "permission": {
    "question": "allow",
    "skill": "allow",
    "doom_loop": "ask",
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "rmdir *": "ask",
      "unlink *": "ask",
      "find * -delete*": "ask",
      "find * -exec rm*": "ask",
      "git rm*": "ask",
      "git clean *": "ask",
      "git branch -D*": "ask",
      "git branch --delete*": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git push --delete*": "ask",
      "git reset --hard*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask",
      "git tag -d*": "ask",
      "npm uninstall*": "ask",
      "npm rm *": "ask",
      "npm remove *": "ask",
      "pnpm remove *": "ask",
      "pnpm uninstall*": "ask",
      "pnpm rm *": "ask",
      "yarn remove *": "ask",
      "bun remove *": "ask",
      "docker rm*": "ask",
      "docker rmi*": "ask",
      "docker volume rm*": "ask",
      "docker volume prune*": "ask",
      "docker image prune*": "ask",
      "docker system prune*": "ask",
      "docker network rm*": "ask",
      "docker compose down -v*": "ask",
      "docker compose rm*": "ask",
      "docker container prune*": "ask",
      "psql *DROP*": "ask",
      "psql *DELETE*": "ask",
      "psql *TRUNCATE*": "ask",
      "kubectl delete*": "ask",
      "helm uninstall*": "ask",
      "helm delete*": "ask",
      "terraform destroy*": "ask",
      "aws s3 rm *": "ask",
      "aws s3api delete*": "ask",
      "gh repo delete*": "ask",
      "gh release delete*": "ask",
      "gh issue delete*": "ask",
      "gh pr close*": "ask",
      "sudo *": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "poweroff*": "deny",
      "mkfs*": "deny",
      "dd if=*": "deny",
      "chmod -R 777*": "deny",
      "kill -9 1*": "deny"
    }
  },
  "agent": {
    "ciel": {
      "description": "Ciel v5 — Primary orchestrator. Full pipeline: DOCS → QUOI → ASK → AVEC QUOI → DIVERGE → RECHERCHE → SÉCURITÉ → CODEBASE → ÉVALUER → ASK2 → FAIRE → ADR → RELIRE → PROUVER → MÉMOIRE → META. Dispatch subagents. Depth: Trivial/Standard/Critical/Spike.",
      "mode": "primary",
      "prompt": "{file:./.opencode/agents/ciel.md}",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "question": "allow",
        "skill": "allow",
        "task": {
          "*": "deny",
          "ciel-researcher": "allow",
          "ciel-explorer": "allow",
          "ciel-critic": "allow",
          "ciel-improver": "allow"
        }
      }
    },
    "ciel-researcher": {
      "description": "RECHERCHE — docs officielles, anti-patterns, version changelog. WebFetch + WebSearch.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/ciel-researcher.md}",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "write": "deny",
        "edit": "deny"
      }
    },
    "ciel-explorer": {
      "description": "CODEBASE + FLUX — pattern-fitness, scent-following, git history, LSP navigation.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/ciel-explorer.md}",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "lsp": "allow",
        "write": "deny",
        "edit": "deny"
      }
    },
    "ciel-critic": {
      "description": "RELIRE/CRITIQUER/RCA/FEEDBACK/INVESTIGATE — hostile review, feedback processing, uncertainty investigation.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/ciel-critic.md}",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "write": "deny",
        "edit": "deny"
      }
    },
    "ciel-improver": {
      "description": "Méta-amélioration Ciel — analyse sessions, skill patches, eval harness.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/ciel-improver.md}",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "write": "ask",
        "edit": "ask"
      }
    }
  }
}
