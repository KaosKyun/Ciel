{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "plugin": ["./.opencode/plugins/ciel.ts"],
  "agent": {
    "ciel-critic": {
      "name": "ciel-critic",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6"
    },
    "ciel-explorer": {
      "name": "ciel-explorer",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6"
    },
    "ciel-researcher": {
      "name": "ciel-researcher",
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5-20251001"
    },
    "ciel-improver": {
      "name": "ciel-improver",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6"
    }
  }
}
