{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "plugin": [
    "./.opencode/plugins/ciel.ts"
  ],
  "permission": {
    "task": {
      "*": "allow"
    }
  },
  "agent": {
    "ciel-plan": {
      "description": "Ciel Plan — Analyse, planning et dispatch des subagents. Read-only (edit denied).",
      "mode": "primary",
      "prompt": "{file:./.opencode/agents/ciel-plan.md}",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "task": {
          "ciel-explorer": "allow",
          "ciel-researcher": "allow",
          "ciel-critic": "allow",
          "ciel-build": "allow"
        }
      }
    },
    "ciel-build": {
      "description": "Ciel Build — Implémentation, FAIRE gates, RELIRE. Full tools.",
      "mode": "primary",
      "prompt": "{file:./.opencode/agents/ciel-build.md}",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "ciel-critic": "allow",
          "ciel-explorer": "allow"
        }
      }
    },
    "ciel-researcher": {
      "description": "RECHERCHE — docs officielles, anti-patterns. WebFetch + WebSearch.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/ciel-researcher.md}",
      "temperature": 0.1,
      "tools": {
        "read": true,
        "webfetch": true,
        "websearch": true,
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "ciel-explorer": {
      "description": "CODEBASE + FLUX — pattern-fitness, flux-narrator. Read-only.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/ciel-explorer.md}",
      "temperature": 0.1,
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "ciel-critic": {
      "description": "RELIRE/CRITIQUER/RCA — hostile review. Bash allowed.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/ciel-critic.md}",
      "temperature": 0.1,
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "ciel-improver": {
      "description": "Méta-amélioration Ciel — analyse sessions, skill patches. SDK Client pour evals.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/ciel-improver.md}",
      "temperature": 0.1,
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "webfetch": true,
        "websearch": true,
        "write": false,
        "edit": false
      }
    }
  }
}
