{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./.opencode/plugins/ciel.ts"
  ],
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "question": "allow",
    "skill": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow",

      "rm *": "deny",
      "rmdir *": "ask",
      "unlink *": "ask",
      "find * -delete*": "ask",
      "find * -exec rm*": "ask",

      "git rm*": "ask",
      "git clean *": "ask",
      "git branch -D*": "ask",
      "git branch --delete*": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git push --delete*": "ask",
      "git reset --hard*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask",
      "git tag -d*": "ask",

      "npm uninstall*": "ask",
      "npm rm *": "ask",
      "npm remove *": "ask",
      "pnpm remove *": "ask",
      "pnpm uninstall*": "ask",
      "pnpm rm *": "ask",
      "yarn remove *": "ask",
      "bun remove *": "ask",

      "docker rm*": "ask",
      "docker rmi*": "ask",
      "docker volume rm*": "ask",
      "docker volume prune*": "ask",
      "docker image prune*": "ask",
      "docker system prune*": "ask",
      "docker network rm*": "ask",
      "docker compose down -v*": "ask",
      "docker compose rm*": "ask",
      "docker container prune*": "ask",

      "psql *DROP*": "ask",
      "psql *DELETE*": "ask",
      "psql *TRUNCATE*": "ask",
      "kubectl delete*": "ask",
      "helm uninstall*": "ask",
      "helm delete*": "ask",
      "terraform destroy*": "ask",
      "aws s3 rm *": "ask",
      "aws s3api delete*": "ask",

      "gh repo delete*": "ask",
      "gh release delete*": "ask",
      "gh issue delete*": "ask",
      "gh pr close*": "ask",

      "sudo *": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "poweroff*": "deny",
      "mkfs*": "deny",
      "dd if=*": "deny",
      "chmod -R 777*": "deny",
      "kill -9 1*": "deny"
    }
  }
}
