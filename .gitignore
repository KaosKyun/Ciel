# Local environment / config — never commit
.env
.env.local
.env.*.local

# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/

# Temp
*.tmp
*.swp
*~

# Ciel local manifest snapshots (for debugging)
.ciel-manifest.debug.json

# Project-level overlay created by install.sh (per-machine, not source of truth)
ciel-overlay.md

# Claude Code generated/build files (not source of truth)
.claude/skills/
.claude/settings.local.json
.claude/settings.json.bak-*

# OpenCode config backups created by install.sh
opencode.json.bak-*

# Per-session state written by PreCompact / Stop hooks + meta-critiquer.
# Useful for the next session to resume without dead-end loops, but not
# source of truth. Belongs on the developer machine, not in git history.
.claude/session-progress.md

# Nested git repo (separate project)
Ciel/
