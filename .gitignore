# Local environment / config — never commit
.env
.env.local
.env.*.local

# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/

# Temp
*.tmp
*.swp
*~

# Ciel local manifest snapshots (for debugging)
.ciel-manifest.debug.json

# Build artifacts (compiled JS from tsx/tsc in root, not in packages/*)
/scripts/*.js
/scripts/*.js.map
/scripts/*.d.ts
/scripts/*.d.ts.map
/test-ciel.js
/test-ciel.js.map
/test-ciel.d.ts
/test-ciel.d.ts.map
/tsconfig.tsbuildinfo

# Project-level overlay created by install.sh (per-machine, not source of truth)
ciel-overlay.md

# Claude Code generated/build files (not source of truth)
.claude/skills/
.claude/hooks/
.claude/settings.local.json
.claude/settings.json.bak-*

# OpenCode config backups created by install.sh
opencode.json.bak-*

# Per-session state written by PreCompact / Stop hooks + meta-critiquer.
# Useful for the next session to resume without dead-end loops, but not
# source of truth. Belongs on the developer machine, not in git history.
.claude/session-progress.md

# Cued-recall memory corpus is per-project local state — captures contain
# project-specific tribal knowledge that does not belong in source. The
# scaffolding (hooks, skills, ADR, slash command) lives in source; the
# corpus itself stays on the developer/team machine.
.ciel/memory/

# Python bytecode cache from memory-engine.py
hooks/__pycache__/
__pycache__/

# Nested git repo (separate project)
/Ciel/

# Monorepo build artifacts
packages/*/dist/
packages/*/node_modules/

# Root node_modules (created by npm workspaces)
node_modules/

# NPM pack artifacts
*.tgz
