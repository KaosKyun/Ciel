{
  "autoMemoryEnabled": true,
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[CIEL v5] Session started -- depth classification active\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-test-first.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(rm *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-destructive.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "prompt",
            "if": "Bash(gh pr create *)",
            "prompt": "Is the PR body present? If not, ask the user to add one using pr-body-generator. Respond with a JSON object: {\"decision\":\"allow\"} or {\"decision\":\"block\",\"reason\":\"...\"}."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/track-file.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "prompt",
            "if": "Write(*/auth/*)|Edit(*/auth/*)|Write(*/security/*)|Edit(*/security/*)",
            "prompt": "The file being modified is in an auth or security path. Should we trigger STRIDE analysis? Respond: {\"decision\":\"allow\"} or {\"decision\":\"block\",\"reason\":\"...\"}."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "ciel-explorer",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[CIEL] Explorer started: $(date -u +%Y-%m-%dT%H:%M:%SZ)\" >> \"$CLAUDE_PROJECT_DIR/.ciel/exploration-log.md\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/meta-critiquer.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[CIEL] Pre-compact -- saving state\" >> \"$CLAUDE_PROJECT_DIR/.ciel/compact-log.md\""
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "A teammate is idle. Should we keep them working? Respond: {\"decision\":\"allow\"} to let them rest, or {\"decision\":\"block\"} to keep them working."
          }
        ]
      }
    ]
  }
}
