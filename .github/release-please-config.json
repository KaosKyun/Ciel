{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "node",
      "extra-files": [
        "VERSION",
        {
          "type": "json",
          "path": "packages/ciel/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "scripts/install.sh",
          "pattern": "CIEL_VERSION=\"[^\"]+\""
        },
        {
          "type": "generic",
          "path": "hooks/session-start.sh",
          "pattern": "CIEL v[0-9]+\\.[0-9]+\\.[0-9]+"
        }
      ]
    }
  }
}
