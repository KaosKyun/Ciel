{
  "_comment": "Ciel MCP template — opt-in servers. Install with: bash scripts/install.sh --with-mcp=playwright,context7",
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    }
  }
}
